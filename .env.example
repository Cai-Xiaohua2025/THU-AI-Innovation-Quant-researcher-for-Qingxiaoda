QINGYAN_HOST=0.0.0.0
QINGYAN_PORT=8787
QINGYAN_DEBUG=false
QINGYAN_API_TOKEN=
QINGYAN_PUBLIC_BASE_URL=
QINGYAN_REPORT_DIR=outputs/reports
QINGYAN_CACHE_DIR=outputs/cache
QINGYAN_CONVERSATION_DIR=outputs/conversations
QINGYAN_SAVE_CONVERSATIONS=true
QINGYAN_CONVERSATION_MAX_CHARS=200000
QINGYAN_CACHE_RETENTION_DAYS=0
QINGYAN_REPORT_RETENTION_DAYS=0
QINGYAN_CONVERSATION_RETENTION_DAYS=0
QINGYAN_MAX_REQUEST_BYTES=2097152
QINGYAN_MAX_DOWNLOAD_BYTES=26214400
QINGYAN_MAX_IMAGE_BYTES=10485760
QINGYAN_MAX_FILES_PER_REQUEST=5
QINGYAN_REQUEST_TIMEOUT_SEC=12
QINGYAN_DATA_COLLECTION_WORKERS=4
QINGYAN_ANNOUNCEMENT_LOOKBACK_DAYS=180
QINGYAN_ANNOUNCEMENT_ATTACHMENT_MAX_FILES=3
QINGYAN_ANNOUNCEMENT_ATTACHMENT_MAX_BYTES=8388608
QINGYAN_ANNOUNCEMENT_ATTACHMENT_MAX_PAGES=20
QINGYAN_ANNOUNCEMENT_ATTACHMENT_MAX_CHARS=9000
QINGYAN_ALLOW_PRIVATE_FILE_URLS=false
QINGYAN_REQUIRE_FILE_AUTH=false
QINGYAN_SIGN_ARTIFACT_URLS=false
QINGYAN_ARTIFACT_SIGNING_KEY=
QINGYAN_ARTIFACT_URL_TTL_SEC=3600
QINGYAN_ARTIFACT_INDEX_PATH=outputs/artifacts/index.json
QINGYAN_TRUSTED_PROXY_COUNT=1
QINGYAN_CORS_ORIGINS=*

# Optional external backtest gateway. If left blank, local fallback simulation is used.
QINGYAN_BACKTEST_GATEWAY_URL=
QINGYAN_BACKTEST_GATEWAY_TOKEN=
QINGYAN_BACKTEST_FEE_BPS=0
QINGYAN_BACKTEST_SLIPPAGE_BPS=0
QINGYAN_BACKTEST_RISK_FREE_RATE=0

# Optional. Disabled by default for faster and more stable demos.
QINGYAN_ENABLE_AKSHARE=false

# Optional OpenAI-compatible upstream LLM. Leave blank to use deterministic fallback only.
# BASE_URL accepts https://host, https://host/v1, or a full .../chat/completions URL.
QINGYAN_LLM_BASE_URL=
QINGYAN_LLM_API_KEY=
QINGYAN_LLM_MODEL=
QINGYAN_LLM_TIMEOUT_SEC=90
QINGYAN_LLM_MAX_TOKENS=3600
QINGYAN_LLM_MAX_INPUT_CHARS=60000
QINGYAN_LLM_TEMPERATURE=0.2
